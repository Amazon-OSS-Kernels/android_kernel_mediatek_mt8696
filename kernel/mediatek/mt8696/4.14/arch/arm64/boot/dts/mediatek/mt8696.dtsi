#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/memory/mt8696-larb-port.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/clock/mt8696-clk.h>
#include <dt-bindings/power/mt8696-power.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/gce/mt8696-gce.h>
#include "mt8696-pinfunc.h"

/ {
	model = "MT8696";
	compatible = "mediatek,mt8696";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
	};

	cpus: cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		#cooling-cells = <2>;

		cpu0: cpu@000 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0000>;
			enable-method = "psci";
			cpu-idle-states = <&cpuoff &clusteroff &mcusysoff>;
			clock-frequency = <1700000000>;
		};

		cpu1: cpu@001 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0100>;
			enable-method = "psci";
			cpu-idle-states = <&cpuoff &clusteroff &mcusysoff>;
			clock-frequency = <1700000000>;
		};

		cpu2: cpu@002 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0200>;
			enable-method = "psci";
			cpu-idle-states = <&cpuoff &clusteroff &mcusysoff>;
			clock-frequency = <1700000000>;
		};

		cpu3: cpu@003 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0300>;
			enable-method = "psci";
			cpu-idle-states = <&cpuoff &clusteroff &mcusysoff>;
			clock-frequency = <1700000000>;
		};

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
				core1 {
					cpu = <&cpu1>;
				};
				core2 {
					cpu = <&cpu2>;
				};
				core3 {
					cpu = <&cpu3>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpuoff: cpuoff {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x00010001>;
				entry-latency-us = <100>;
				exit-latency-us = <250>;
				min-residency-us = <1600>;
			};

			clusteroff: clusteroff {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x01010001>;
				entry-latency-us = <100>;
				exit-latency-us = <350>;
				min-residency-us = <2100>;
			};

			mcusysoff: mcusysoff {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x01010002>;
				entry-latency-us = <300>;
				exit-latency-us = <1200>;
				min-residency-us = <2600>;
			};
		};
	};

	clocks {
		clk_null: clk_null {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <0>;
		};

		clk26m: clk26m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <26000000>;
			clock-output-names = "clk26m";
		};

		clk13m: clk13m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <13000000>;
		};

		clk12m: clk12m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <12000000>;
		};

		clk32k: clk32k {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32768>;
			clock-output-names = "clk32k";
		};

		clki2sin_mclk_i: oscillator@0 {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <49152000>;
			clock-output-names = "i2si0_mck_i";
		};

		clksplin_mclk_i: oscillator@1 {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <49152000>;
			clock-output-names = "splin_mck_i";
		};
	};

	firmware: firmware {
		android: android {
			compatible = "android,firmware";
			fstab: fstab {
				compatible = "android,fstab";
			};
		};
	};

	pmu {
		compatible = "arm,armv8-pmuv3",
			     "arm,cortex-a7-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH>;
	};

	pmu-dsu-0 {
		compatible = "arm,dsu-pmu";
		interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>;
		cpus = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		reserve-memory-mcupm_share {
			compatible = "mediatek,reserve-memory-mcupm_share";
			no-map;
			status = "okay";
#if defined(CONFIG_MTK_GMO_RAM_OPTIMIZE) || defined(CONFIG_MTK_MET_MEM_ALLOC)
			size = <0 0x210000>; /* 2M + 64K */
#else
			size = <0 0x610000>; /* 6M + 64K */
#endif
			alignment = <0 0x10000>;
			alloc-ranges = <0 0x40000000 0 0x60000000>;
		};

		atf_reserved_mem: atf-reserved-memory@43000000 {
			compatible = "mediatek,mt8696-atf-reserved-memory";
			no-map;
			reg = <0 0x43000000 0 0x40000>;
		};

		optee_reserved_mem: optee-reserved-memory@83040000 {
			compatible = "mediatek,mt8696-optee-reserved-memory";
			no-map;
			reg = <0 0x83040000 0 0x14200000>;
		};

		atf_aee_log_reserved_mem@57240000 {
			compatible = "mediatek,mt8696-atf-aee-log";
			no-map;
			reg = <0 0x57240000 0 0x4000>;
		};

		ram_console-reserved-memory@59400000 {
			compatible = "mediatek,ram_console";
			reg = <0 0x59400000 0 0x10000>;
		};

		pstore-reserved-memory@59410000 {
			compatible = "mediatek,pstore";
			reg = <0 0x59410000 0 0xe0000>;
		};

		minirdump-reserved-memory@594f0000{
			compatible = "mediatek,minirdump";
			reg = <0 0x594f0000 0 0x10000>;
		};
	};

	timer: timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_HIGH>;
	};

	soc {
		#address-cells = <2>;
		#size-cells = <2>;
		compatible = "simple-bus";
		ranges;

		soc_data: soc_data@8000000 {
			compatible = "mediatek,mt8696-efuse",
				     "mediatek,efuse";
			reg = <0 0x08000000 0 0x0010>;
			#address-cells = <1>;
			#size-cells = <1>;
		};

		gic: interrupt-controller@c000000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <3>;
			interrupt-parent = <&gic>;
			#redistributor-regions = <1>;
			interrupt-controller;
			reg = <0 0x0c000000 0 0x40000>,  /* GICD */
			      <0 0x0c040000 0 0x200000>; /* GICR */
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
		};

		mcucfg: syscon@c53a000 {
			compatible = "mediatek,mt8696-mcucfg", "syscon";
			reg = <0 0x0c53a000 0 0x1000>;
			#clock-cells = <1>;
		};

		mcupm: mcupm@c540000 {
			compatible = "mediatek,mcupm";
			reg = <0 0x0c540000 0 0x22000>,
			      <0 0x0c55fb00 0 0xa0>,
			      <0 0x0c562004 0 0x4>,
			      <0 0x0c562018 0 0x4>,
			      <0 0x0c562000 0 0x4>,
			      <0 0x0c562010 0 0x4>,
			      <0 0x0c55fba0 0 0xa0>,
			      <0 0x0c562004 0 0x4>,
			      <0 0x0c562018 0 0x4>,
			      <0 0x0c562000 0 0x4>,
			      <0 0x0c562010 0 0x4>,
			      <0 0x0c55fc40 0 0xa0>,
			      <0 0x0c562004 0 0x4>,
			      <0 0x0c562018 0 0x4>,
			      <0 0x0c562000 0 0x4>,
			      <0 0x0c562010 0 0x4>,
			      <0 0x0c55fce0 0 0xa0>,
			      <0 0x0c562004 0 0x4>,
			      <0 0x0c562018 0 0x4>,
			      <0 0x0c562000 0 0x4>,
			      <0 0x0c562010 0 0x4>,
			      <0 0x0c55fd80 0 0xa0>,
			      <0 0x0c562004 0 0x4>,
			      <0 0x0c562018 0 0x4>,
			      <0 0x0c562000 0 0x4>,
			      <0 0x0c562010 0 0x4>,
			      <0 0x0c55fe20 0 0xa0>,
			      <0 0x0c562004 0 0x4>,
			      <0 0x0c562018 0 0x4>,
			      <0 0x0c562000 0 0x4>,
			      <0 0x0c562010 0 0x4>,
			      <0 0x0c55fec0 0 0xa0>,
			      <0 0x0c562004 0 0x4>,
			      <0 0x0c562018 0 0x4>,
			      <0 0x0c562000 0 0x4>,
			      <0 0x0c562010 0 0x4>,
			      <0 0x0c55ff60 0 0xa0>,
			      <0 0x0c562004 0 0x4>,
			      <0 0x0c562018 0 0x4>,
			      <0 0x0c562000 0 0x4>,
			      <0 0x0c562010 0 0x4>;
			reg-names = "mcupm_base",
				    "mbox0_base",
				    "mbox0_set",
				    "mbox0_clr",
				    "mbox0_send",
				    "mbox0_recv",
				    "mbox1_base",
				    "mbox1_set",
				    "mbox1_clr",
				    "mbox1_send",
				    "mbox1_recv",
				    "mbox2_base",
				    "mbox2_set",
				    "mbox2_clr",
				    "mbox2_send",
				    "mbox2_recv",
				    "mbox3_base",
				    "mbox3_set",
				    "mbox3_clr",
				    "mbox3_send",
				    "mbox3_recv",
				    "mbox4_base",
				    "mbox4_set",
				    "mbox4_clr",
				    "mbox4_send",
				    "mbox4_recv",
				    "mbox5_base",
				    "mbox5_set",
				    "mbox5_clr",
				    "mbox5_send",
				    "mbox5_recv",
				    "mbox6_base",
				    "mbox6_set",
				    "mbox6_clr",
				    "mbox6_send",
				    "mbox6_recv",
				    "mbox7_base",
				    "mbox7_set",
				    "mbox7_clr",
				    "mbox7_send",
				    "mbox7_recv";
			interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "mbox0",
					  "mbox1",
					  "mbox2",
					  "mbox3",
					  "mbox4",
					  "mbox5",
					  "mbox6",
					  "mbox7";
		};

		topckgen: syscon@10000000 {
			compatible = "mediatek,mt8696-topckgen", "syscon";
			reg = <0 0x10000000 0 0x1000>;
			#clock-cells = <1>;
		};

		infrasys: syscon@10001000 {
			compatible = "mediatek,mt8696-infracfg", "syscon";
			reg = <0 0x10001000 0 0x1000>;
			#clock-cells = <1>;
		};

		perisys: syscon@10003000 {
			compatible = "mediatek,mt8696-pericfg", "syscon";
			reg = <0 0x10003000 0 0x1000>;
			#clock-cells = <1>;
		};

		syscfg_pctl_a: syscfg_pctl_a@10005000 {
			compatible = "mediatek,pctl-a-syscfg", "syscon";
			reg = <0 0x10005000 0 0x1000>;
		};

		scpsys: syscon@10006000 {
			compatible = "mediatek,mt8696-scpsys", "syscon";
			#power-domain-cells = <1>;
			reg = <0 0x10006000 0 0x1000>;
			clocks = <&topckgen CLK_TOP_MMSEL>,
				<&topckgen CLK_TOP_VDEC_SEL>,
				<&topckgen CLK_TOP_VENC_SEL>,
				<&topckgen CLK_TOP_VDEC_SEL>,
				<&topckgen CLK_TOP_VENC_SEL>,
				<&topckgen CLK_TOP_MMSEL>,
				<&topckgen CLK_TOP_HDMI_APB_SEL>,
				<&topckgen CLK_TOP_RV33_SEL>,
				<&topckgen CLK_TOP_MEMSEL>,
				<&infrasys CLK_INFRA_IPSYS>,
				<&topckgen CLK_TOP_AUDIO_26MSEL>,
				<&topckgen CLK_TOP_ETH_125MSEL>;
			clock-names = "mm", "vdec-0",
				"venc-0", "mm-0", "mm-1",
				"osd-0", "hdmiapb",
				"mmcu-0", "mmcu-1", "mmcu-2",
				"audio", "ether";
			infracfg = <&infrasys>;
		};

		toprgu: toprgu@10007000 {
			compatible = "mediatek,mt8696-rgu";
			reg = <0 0x10007000 0 0x1000>;
			interrupts = <GIC_SPI 96 IRQ_TYPE_EDGE_FALLING>;
			registered-in-atf = <1>;
			#reset-cells = <1>;
		};

		stc: stc@10008000 {
			compatible = "mediatek,gpt-stc";
			reg = <0 0x10008000 0 0x40>;
		};

		pio: pinctrl@1000b000 {
			compatible = "mediatek,mt8696-pinctrl";
			reg = <0 0x1000b000 0 0x1000>;
			mediatek,pctl-regmap = <&syscfg_pctl_a>,
				       <&syscfg_pctl_0>,
				       <&syscfg_pctl_1>,
				       <&syscfg_pctl_2>,
				       <&syscfg_pctl_3>,
				       <&syscfg_pctl_4>;
			pins-are-numbered;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <4>;
			interrupts = <GIC_SPI 169 IRQ_TYPE_LEVEL_HIGH>;
		};

		apmixedsys: syscon@1000c000 {
			compatible = "mediatek,mt8696-apmixedsys", "syscon";
			reg = <0 0x1000c000 0 0x1000>;
			#clock-cells = <1>;
		};

		fhctl@1000ce00 {
			compatible = "mediatek,fhctl";
			reg = <0 0x1000ce00 0 0xD4>;
		};

		irrx: irrx@1000d000 {
			compatible = "mediatek,mt8696-irrx";
			reg = <0 0x1000d000 0 0x1000>;
			interrupts = <GIC_SPI 181 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		sys_timer@10017000 {
			compatible = "mediatek,sys_timer";
			reg = <0 0x10017000 0 0x1000>;
			reg-names = "sys_timer_base";
			interrupts = <GIC_SPI 193 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk13m>;
		};

		i2c4: i2c@10018000 {
			compatible = "mediatek,mt8696-i2c";
			reg = <0 0x10018000 0 0x90>,
			      <0 0x11000280 0 0x80>;
			interrupts = <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>;
			clock-div = <1>;
			clocks = <&infrasys CLK_INFRA_IIC_AO>,
				 <&perisys CLK_PERI_AP_DMA>;
			clock-names = "main", "dma";
			status = "disabled";
		};

		dramc: dramc@10104000 {
			compatible = "mediatek,dramc";
			reg = <0 0x10104000 0 0x2000>, /* DRAMC AO CHA */
			      <0 0x10114000 0 0x2000>, /* DRAMC AO CHB */
			      <0 0x10106000 0 0x1000>, /* DRAMC NAO CHA */
			      <0 0x10116000 0 0x1000>, /* DRAMC NAO CHB */
			      <0 0x10100000 0 0x2000>, /* DDRPHY AO CHA */
			      <0 0x10110000 0 0x2000>, /* DDRPHY AO CHB */
			      <0 0x10108000 0 0x1000>, /* DDRPHY NAO CHA */
			      <0 0x10118000 0 0x1000>; /* DDRPHY NAO CHB */
		};

		emi: emi@10203000 {
			compatible = "mediatek,mt8696-emi", "mediatek,emi";
			reg = <0 0x10203000 0 0x1000>,
			      <0 0x10226000 0 0x1000>,
			      <0 0x10107000 0 0x1000>,
			      <0 0x10117000 0 0x1000>;
			interrupts = <GIC_SPI 156 IRQ_TYPE_LEVEL_HIGH>;
		};

		iommu: m4u@10205000 {
			compatible = "mediatek,mt8696-m4u";
			reg = <0 0x10205000 0 0x1000>;
			mediatek,larbs = <&larb0 &larb1 &larb3 &larb4
					  &larb5 &larb6 &larb7 &larb8>;
			interrupts = <GIC_SPI 163 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&infrasys CLK_INFRA_M4U>,
				 <&perisys CLK_PERI_MM_APB>;
			clock-names = "bclk", "apb";
			#iommu-cells = <1>;
		};

		systracker: systracker@10208000 {
			compatible = "mediatek,bus_dbg-v2";
			reg = <0 0x10208000 0 0x1000>,
			      <0 0x10001000 0 0x1000>;
			mediatek,bus_dbg_con_offset = <0x2fc>;
			interrupts = <GIC_SPI 153 IRQ_TYPE_LEVEL_LOW>;
		};

		iommu_sec: m4u@1020e000 {
			compatible = "mediatek,sec_m4u";
			reg = <0 0x1020e000 0 0x1000>;
			interrupts = <GIC_SPI 164 IRQ_TYPE_LEVEL_HIGH>;
			#iommu-cells = <1>;
		};

		rng: rng@1020f000 {
			compatible = "mediatek,mt8696-rng",
				     "mediatek,mt7623-rng";
			reg = <0 0x1020f000 0 0x100>;
			clocks = <&infrasys CLK_INFRA_TRNG>;
			clock-names = "rng";
		};

		nna_top_ports_wrapper_0: nna_top_ports_wrapper@10216000 {
			compatible = "amazon,nna-1.0";
			interrupt-names = "nna_interrupt";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 263 IRQ_TYPE_LEVEL_HIGH>;
			/* minor-number = <UNIQUE_NUMBER>; */
			reg = <0x0 0x10216000 0x0 0x1000>;
			clocks = <&topckgen CLK_TOP_NNA0_SEL>,
				 <&ipsys CLK_NNA0>,
				 <&ipsys CLK_NNA0_PWR>,
				 <&ipsys CLK_NNA0_26MEN>;
			clock-names = "nna0_sel",
				      "nna0",
				      "nna0_pwr",
				      "nna0_26men";
			power-domains = <&scpsys MT8696_POWER_DOMAIN_NNA0>;
		};

		ipsys: syscon@10218000 {
			compatible = "mediatek,mt8696-nna", "syscon";
			reg = <0 0x10218000 0 0x1000>;
			#clock-cells = <1>;
		};

		gce_mbox: gce_mbox@10228000 {
			compatible = "mediatek,mailbox-gce";
			reg = <0 0x10228000 0 0x4000>;
			interrupts = <GIC_SPI 162 IRQ_TYPE_LEVEL_HIGH>;
			default_tokens =
				/bits/ 16 <CMDQ_SYNC_TOKEN_GPR_SET_0>,
				/bits/ 16 <CMDQ_SYNC_TOKEN_GPR_SET_1>,
				/bits/ 16 <CMDQ_SYNC_TOKEN_GPR_SET_2>,
				/bits/ 16 <CMDQ_SYNC_TOKEN_GPR_SET_3>,
				/bits/ 16 <CMDQ_SYNC_TOKEN_GPR_SET_4>;
			#mbox-cells = <3>;
			#gce-event-cells = <1>;
			#gce-subsys-cells = <2>;
			clocks = <&infrasys CLK_INFRA_GCE>;
			clock-names = "gce";
		};

		gce_mbox_svp: gce_mbox_svp@10228000 {
			compatible = "mediatek,mailbox-gce-sec";
			reg = <0 0x10228000 0 0x4000>;
			interrupts = <GIC_SPI 162 IRQ_TYPE_LEVEL_HIGH>;
			mboxes = <&gce_mbox 15 CMDQ_NO_TIMEOUT CMDQ_THR_PRIO_1>;
			#mbox-cells = <3>;
			clocks = <&infrasys CLK_INFRA_GCE>;
			clock-names = "gce";
		};

		auxadc: adc@11001000 {
			compatible = "mediatek,mt8696-auxadc",
				     "mediatek,mt8173-auxadc";
			reg = <0 0x11001000 0 0x1000>;
			clocks = <&perisys CLK_PERI_AUXADC>;
			clock-names = "main";
			#io-channel-cells = <1>;
		};

		uart0: serial@11002000 {
			compatible = "mediatek,mt8696-uart",
				     "mediatek,mt6577-uart";
			reg = <0 0x11002000 0 0x1000>;
			interrupts = <GIC_SPI 113 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk26m>, <&perisys CLK_PERI_UART0>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		uart1: serial@11002400 {
			compatible = "mediatek,mt8696-uart",
				     "mediatek,mt6577-uart";
			reg = <0 0x11002400 0 0x1000>;
			interrupts = <GIC_SPI 114 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk26m>, <&perisys CLK_PERI_UART1>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		uart2: serial@10049000 {
			compatible = "mediatek,mt8696-uart",
				     "mediatek,mt6577-uart";
			reg = <0 0x11002800 0 0x1000>;
			interrupts = <GIC_SPI 115 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk26m>, <&infrasys CLK_INFRA_UART_AO>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		i2c0: i2c@11007000 {
			compatible = "mediatek,mt8696-i2c";
			reg = <0 0x11007000 0 0x90>,
			      <0 0x11000080 0 0x80>;
			interrupts = <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>;
			clock-div = <1>;
			clocks = <&perisys CLK_PERI_I2C0>,
				 <&perisys CLK_PERI_AP_DMA>;
			clock-names = "main", "dma";
			status = "disabled";
		};

		i2c1: i2c@11008000 {
			compatible = "mediatek,mt8696-i2c";
			reg = <0 0x11008000 0 0x90>,
			      <0 0x11000100 0 0x80>;
			interrupts = <GIC_SPI 107 IRQ_TYPE_LEVEL_HIGH>;
			clock-div = <1>;
			clocks = <&perisys CLK_PERI_I2C0>,
				 <&perisys CLK_PERI_AP_DMA>;
			clock-names = "main", "dma";
			status = "disabled";
		};

		i2c2: i2c@11009000 {
			compatible = "mediatek,mt8696-i2c";
			reg = <0 0x11009000 0 0x90>,
			      <0 0x11000180 0 0x80>;
			interrupts = <GIC_SPI 108 IRQ_TYPE_LEVEL_HIGH>;
			clock-div = <1>;
			clocks = <&perisys CLK_PERI_I2C0>,
				 <&perisys CLK_PERI_AP_DMA>;
			clock-names = "main", "dma";
			status = "disabled";
		};

		spi0: spi@1100a000 {
			compatible = "mediatek,ipm-spi";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0 0x1100a000 0 0x1000>;
			interrupts = <GIC_SPI 139 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&topckgen CLK_TOP_UNIVPLL2_D4>,
				 <&topckgen CLK_TOP_SPI_SEL>,
				 <&perisys CLK_PERI_SPI0>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			status = "disabled";
		};

		eem_fsm: eem_fsm@1100b000 {
			compatible = "mediatek,eem_fsm";
			reg = <0 0x1100b000 0 0x1000>;
			eem-status = <1>;
			sn-status = <0>;
			eem-initmon-little = <0xff>;
			eem-initmon-cci = <0xff>;
			eem-clamp-little = <0>;
			eem-clamp-cci = <0>;
			eem-offset-little = <0xff>;
			eem-offset-cci = <0xff>;
		};

		thermal: thermal@1100b800 {
			compatible = "mediatek,mt8696-thermal";
			reg = <0 0x1100b800 0 0x200>;
			interrupts = <GIC_SPI 100 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&perisys CLK_PERI_THERM>,
				 <&perisys CLK_PERI_AUXADC>;
			clock-names = "therm", "auxadc";
			//device_name = "1100b800.thermal";
			auxadc = <&auxadc>;
			#thermal-sensor-cells = <0>;
			mediatek,apmixed = <&apmixedsys>;
			mediatek,infracfg_ao = <&infrasys>;
			status = "okay";
		};

		tboard_thermistor: thermal-sensor {
			compatible = "generic-adc-thermal";
			#thermal-sensor-cells = <0>;
			io-channels = <&auxadc 0>, <&auxadc 1>, <&auxadc 2>;
			io-channel-names = "sensor-channel";
		};

		nandc: nfi@1100e000 {
			compatible = "mediatek,mt8696-nfc";
			reg = <0 0x1100e000 0 0x1000>,
			      <0 0x1100f000 0 0x1000>;
			interrupts = <GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 117 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&perisys CLK_PERI_NFI>,
