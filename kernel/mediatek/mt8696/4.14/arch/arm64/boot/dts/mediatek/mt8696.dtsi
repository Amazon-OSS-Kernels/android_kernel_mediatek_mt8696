		ether: syscon@1101a000 {
			compatible = "mediatek,mt8696-ether", "syscon";
			reg = <0 0x1101a000 0 0x1000>;
			#clock-cells = <1>;
		};

		ethernet: ethernet@1101a000 {
			compatible = "mediatek,mt8696-eth";
			reg = <0 0x1101a000 0 0x380>;
			interrupts = <GIC_SPI 266 IRQ_TYPE_LEVEL_HIGH>;
			clock-names = "core",
				      "reg",
				      "trans",
				      "ether_axi",
				      "ether_apb",
				      "ether_rx",
				      "ether_tx",
				      "ether_rx_ext",
				      "ether_tx_ext",
				      "ether_mac",
				      "ether_nclk";
			clocks = <&perisys  CLK_PERI_GMAC>,
				 <&perisys CLK_PERI_GMAC_PCLK>,
				 <&topckgen CLK_TOP_ETH_250MSEL>,
				 <&ether CLK_ETH_AXI_MCLKEN>,
				 <&ether CLK_ETH_APB_PCLKEN>,
				 <&ether CLK_ETH_RX_I_RMIIEN>,
				 <&ether CLK_ETH_TX_I_RMIIEN>,
				 <&ether CLK_ETH_RX_IEN>,
				 <&ether CLK_ETH_TX_IEN>,
				 <&ether CLK_ETH_MAC_EXTEN>,
				 <&ether CLK_ETH_NCLK_IEN>;
			power-domains = <&scpsys MT8696_POWER_DOMAIN_ETHER_PCIE>;
			status = "disabled";
		};

		ssusb: usb@11201000 {
			compatible = "mediatek,mt8696-mtu3",
				     "mediatek,mtu3";
			reg = <0 0x11201000 0 0x2e00>,
			      <0 0x11203e00 0 0x0100>;
			reg-names = "mac", "ippc";
			interrupts = <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&scpsys MT8696_POWER_DOMAIN_SSUSB>;
			phys = <&u2port0 PHY_TYPE_USB2>,
			       <&u2port1 PHY_TYPE_USB2>,
			       <&u2port2 PHY_TYPE_USB2>,
			       <&u3port0 PHY_TYPE_USB3>;
			clocks = <&perisys CLK_PERI_USB0>,
				 <&topckgen CLK_TOP_SSUSB_TOP>,
				 <&topckgen CLK_TOP_USB30_SEL>;
			clock-names = "sys_ck", "free_ck", "ahb_ck";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			status = "disabled";

			usb_host0: xhci@11200000 {
				compatible = "mediatek,mt8696-xhci",
					     "mediatek,mtk-xhci";
				reg = <0 0x11200000 0 0x1000>;
				reg-names = "mac";
				interrupts = <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>;
				clocks = <&perisys CLK_PERI_USB0>,
					 <&topckgen CLK_TOP_SSUSB_TOP>,
					 <&topckgen CLK_TOP_USB30_SEL>;
				clock-names = "sys_ck", "free_ck", "ahb_ck";
				mediatek,wakeup-src = <3>;
				mediatek,syscon-wakeup = <&perisys>;
				status = "okay";
			};
		};
		afe32: audio-controller@11220000 {
			compatible = "mediatek,mt8532-afe-pcm";
			reg = <0 0x11220000 0 0x6000>,
