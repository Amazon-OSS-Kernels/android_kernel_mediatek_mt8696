			compatible = "mediatek,mt8696-sdio";
			reg = <0 0x11250000 0 0x1000>,
			      <0 0x11c00000 0 0x1000>;
			interrupts = <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&topckgen CLK_TOP_MSDC30_2_SEL>,
				 <&perisys CLK_PERI_MSDC2_H_EN>,
				 <&perisys CLK_PERI_MSDC2_EN>,
				 <&perisys CLK_PERI_MSDC30_2>;
			clock-names = "source", "hclk", "source_cg", "hclk_cg";
			status = "disabled";
		};

		u3phy0: usb-phy@11c20000 {
			compatible = "mediatek,mt8696",
				     "mediatek,generic-tphy-v2";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			status = "okay";

			u2port0: usb-phy@11c20000 {
				reg = <0 0x11c20000 0 0x700>;
				clocks = <&topckgen CLK_TOP_SSUSB_U2_PHY>;
				clock-names = "ref";
				#phy-cells = <1>;
				mediatek,discth = <0x8>;
				status = "okay";
			};

			u3port0: usb-phy@11c20700 {
				reg = <0 0x11c20700 0 0x900>;
				clocks = <&topckgen CLK_TOP_SSUSB_PHY>;
				clock-names = "ref";
				#phy-cells = <1>;
				status = "disabled";
			};

			u2port1: usb-phy@11c21000 {
				reg = <0 0x11c21000 0 0x700>;
				clocks = <&topckgen CLK_TOP_SSUSB_U2_PHY>;
				clock-names = "ref";
				#phy-cells = <1>;
				mediatek,discth = <0x8>;
				status = "disabled";
			};

			u2port2: usb-phy@11c22000 {
				reg = <0 0x11c22000 0 0x700>;
				clocks = <&topckgen CLK_TOP_SSUSB_U2_PHY>;
				clock-names = "ref";
				#phy-cells = <1>;
				mediatek,discth = <0x8>;
				status = "disabled";
			};
		};

		syscfg_pctl_0: syscfg_pctl_0@11c30000 {
			compatible = "mediatek,pctl-0-syscfg", "syscon";
			reg = <0 0x11c30000 0 0x1000>;
		};

		syscfg_pctl_1: syscfg_pctl_1@11d00000 {
			compatible = "mediatek,pctl-1-syscfg", "syscon";
			reg = <0 0x11d00000 0 0x1000>;
