		clovelly: gpu@13000000 {
			#cooling-cells = <2>;
			compatible = "mediatek,mt8696-clovelly";
			reg = <0 0x13000000 0 0x100000>;
			interrupts = <GIC_SPI 254 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "RGX";
