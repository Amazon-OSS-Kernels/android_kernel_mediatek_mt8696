			mediatek,topckgen-regmap = <&topckgen>;
			mediatek,scpsys-regmap = <&scpsys>;
			status = "disabled";
		};

		mmc0: mmc@11230000 {
			compatible = "mediatek,mt8696-mmc";
			reg = <0 0x11230000 0 0x1000>,
			      <0 0x11E00000 0 0x1000>;
			interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&topckgen CLK_TOP_MSDC50_0_SEL>,
				 <&perisys CLK_PERI_MSDC0_H_EN>,
				 <&perisys CLK_PERI_MSDC0_EN>,
				 <&perisys CLK_PERI_MSDC30_0>;
			clock-names = "source", "hclk", "source_cg", "hclk_cg";
			status = "disabled";
		};

