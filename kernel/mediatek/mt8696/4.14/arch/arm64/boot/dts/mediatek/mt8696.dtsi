			clocks = <&mmsys CLK_MMCG2_DRAM_L>,
				 <&dispsys CLK_IMG_DRAMC_L8>;
			clock-names = "apb", "smi";
			power-domains =
				<&scpsys MT8696_POWER_DOMAIN_DISP_MAIN>;
		};

		mmsys: syscon@14000000 {
			compatible = "mediatek,mt8696-mmsys", "syscon";
			reg = <0 0x14000000 0 0x1000>;
			#clock-cells = <1>;
		};

		vq: vq@14000000 {
			compatible = "mediatek,mt8696-vq";
			reg = <0 0x14000000 0 0x1000>, /*mmsys_config*/
			      <0 0x14001500 0 0x100>,  /*vdout_sys*/
			      <0 0x15000000 0 0x100>,  /*disp_top*/
			      <0 0x1500a000 0 0x1000>, /*nr*/
			      <0 0x1500e000 0 0x1000>, /*dispfmt,vdo*/
			      <0 0x1500f000 0 0x100>;  /*wch*/
			power-domains =
				<&scpsys MT8696_POWER_DOMAIN_DISP_COMMON>;
			clocks = <&dispsys CLK_IMG_NR>,
				 <&topckgen CLK_TOP_NR_SEL>,
				 <&topckgen CLK_TOP_UNIVPLL2_D2>,
				 <&dispsys CLK_IMG_VDO_DI>,
				 <&dispsys CLK_IMG_DISPFMT_DI>,
				 <&dispsys CLK_IMG_WR_CHANNEL>,
				 <&dispsys CLK_IMG_DRAMC_L8>,
				 <&topckgen CLK_TOP_DI_SEL>,
				 <&topckgen CLK_TOP_TVDPLL_D2>,
				 <&topckgen CLK_TOP_OSDPLL_D3>;
			clock-names = "nr",
				      "nr_sel",
				      "univpll_d2",
				      "vdo_di",
				      "dispfmt_di",
				      "wr_channel",
				      "dramc_larb8",
				      "di_sel",
				      "tvdpll_d2",
				      "osdpll_d3";
			/*wrch_frame_end*/
			/*nr*/
			/*di_vsync*/
			/*di_frame_end*/
			/*disp_end*/
			/*di_under_run*/
			interrupts = <GIC_SPI 290 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 291 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 292 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 293 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 294 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 295 IRQ_TYPE_LEVEL_HIGH>;
			iommus = <&iommu M4U_PORT_IOMMU_READ>,
				 <&iommu M4U_PORT_IOMMU_WRITE>;
			mediatek,larb = <&larb8>;
		};

		disp_fmt: disp_fmt@14001000 {
			compatible = "mediatek,mt8696-fmt";
			reg = <0 0x10000000 0 0x1000>,
			      <0 0x14001000 0 0x400>,
			      <0 0x15000000 0 0x100>,
			      <0 0x15001000 0 0x100>,
			      <0 0x15008000 0 0x100>;
			interrupts = <GIC_SPI 223 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 224 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 225 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 226 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 227 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 228 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 229 IRQ_TYPE_LEVEL_HIGH>;
		 };

		disp_vdout: disp_vdout@14001000 {
			compatible = "mediatek,mt8696-vdout";
			reg = <0 0x14001000 0 0xd00>;
		 };

		disp_videoin: disp_videoin@14002000 {
			compatible = "mediatek,mt8696-videoin";
			reg = <0 0x14002000 0 0x100>,
			      <0 0x1400e300 0 0x100>;
		 };

		disp_p2i:disp_p2i@14002700{
			compatible = "mediatek,mt8696-p2i";
			reg = <0 0x14002700 0 0x100>;
		 };

		disp_osd: disp_osd@14004000 {
			compatible = "mediatek,mt8696-osd";
			reg = <0 0x14004000 0 0x300>,
			      <0 0x14003000 0 0x300>,
			      <0 0x1400cf80 0 0x80>,
			      <0 0x1400ef80 0 0x80>;
			interrupts = <GIC_SPI 215 IRQ_TYPE_LEVEL_HIGH>;
			mboxes = <&gce_mbox 4 0xffffffff 1>,
				 <&gce_mbox 5 0xffffffff 4>;
			gce-event-names = "OSD3_FRAME_END_IRQ_B";
			gce-events = <&gce_mbox 51>;
		};

		disp_hdr: disp_hdr@14009000 {
			compatible = "mediatek,mt8696-hdr";
			reg = <0 0x14009000 0 0x1000>,
			      <0 0x1400A000 0 0x1000>,
			      <0 0x1400B000 0 0x400>,
			      <0 0x15012000 0 0x1000>,
			      <0 0x15015000 0 0x1000>,
			      <0 0x15016000 0 0x1000>;
			interrupts = <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>;
		};

		larb0: larb@1400c000 {
			compatible = "mediatek,mt8696-smi-larb";
			reg = <0 0x1400c000 0 0x1000>;
			mediatek,smi = <&smi_common>;
			mediatek,larb-id = <0>;
			clocks = <&mmsys CLK_MMCG1_SMI_L0>,
				 <&mmsys CLK_MMCG12_SMI_L0>;
			clock-names = "apb", "smi";
			power-domains =	<&scpsys MT8696_POWER_DOMAIN_OSD_UHD>;
		};

		smi_common: smi@1400d000 {
			compatible = "mediatek,mt8696-smi-common";
			reg = <0 0x1400d000 0 0x1000>;
			clocks = <&mmsys CLK_MMCG0_SMI_COM>,
				 <&mmsys CLK_MMCG0_SMI_COM>;
			clock-names = "apb", "smi";
			power-domains =
				<&scpsys MT8696_POWER_DOMAIN_MMSYS_TOP>;
		};

		larb4: larb@1400e000 {
			compatible = "mediatek,mt8696-smi-larb";
			reg = <0 0x1400e000 0 0x1000>;
			mediatek,smi = <&smi_common>;
			mediatek,larb-id = <4>;
			clocks = <&mmsys CLK_MMCG4_SMI_L4>,
				 <&mmsys CLK_MMCG4_SMI_L4>;
			clock-names = "apb", "smi";
			power-domains =
				<&scpsys MT8696_POWER_DOMAIN_MMSYS_TOP>;
		};

		disp_befifo: disp_befifo@1400f000 {
			compatible = "mediatek,mt8696-befifo";
			reg = <0 0x1400f000 0 0x1000>;
			interrupts = <GIC_SPI 222 IRQ_TYPE_LEVEL_HIGH>;
		};

		disp_fefifo: disp_fefifo@14010000 {
			compatible = "mediatek,mt8696-fefifo";
			reg = <0 0x14010000 0 0x1000>,
			      <0 0x14011000 0 0x1000>,
			      <0 0x15010000 0 0x1000>,
			      <0 0x15017000 0 0x1000>;
			interrupts = <GIC_SPI 252 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 280 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 217 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 207 IRQ_TYPE_LEVEL_HIGH>;
		};

		disp_adl_ml: disp_adl_ml@14013000 {
			compatible = "mediatek,mt8696-adl-ml";
			reg = <0 0x14013000 0 0x1000>,
			      <0 0x15013000 0 0x1000>;
			interrupts = <GIC_SPI 222 IRQ_TYPE_LEVEL_HIGH>;

		};

		disp_mix: disp_mix@14014000 {
			compatible = "mediatek,mt8696-dispmix";
			reg = <0 0x14014000 0 0x200>;
		};

		dispsys: syscon@15000000 {
			compatible = "mediatek,mt8696-disp", "syscon";
			reg = <0 0x15000000 0 0x1000>;
			#clock-cells = <1>;
		};

		disp_vdo: disp_vdo@15001000 {
			compatible = "mediatek,mt8696-vdo";
			reg = <0 0x15001000 0 0x1000>,
			      <0 0x15008000 0 0x1000>;
			#interrupts = <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>;
		};

		larb5: larb@15004000 {
			compatible = "mediatek,mt8696-smi-larb";
			reg = <0 0x15004000 0 0x1000>;
			mediatek,smi = <&smi_common>;
			mediatek,larb-id = <5>;
			clocks = <&mmsys CLK_MMCG6_SMI_L5>,
				 <&dispsys CLK_IMG_SMI_L5>;
			clock-names = "apb", "smi";
			power-domains =
				<&scpsys MT8696_POWER_DOMAIN_DISP_MAIN>;
		};

		larb6: larb@15005000 {
			compatible = "mediatek,mt8696-smi-larb";
			reg = <0 0x15005000 0 0x1000>;
			mediatek,smi = <&smi_common>;
			mediatek,larb-id = <6>;
			clocks = <&mmsys CLK_MMCG7_SMI_L6>,
				 <&dispsys CLK_IMG_SMI_L6>;
			clock-names = "apb", "smi";
			power-domains =
				<&scpsys MT8696_POWER_DOMAIN_DISP_MAIN>;
		};

		disp_r2r: disp_r2r@15006000 {
			compatible = "mediatek,mt8696-r2r";
			reg = <0 0x15006000 0 0x1000>;
			interrupts = <GIC_SPI 251 IRQ_TYPE_LEVEL_HIGH>;
		};

		irt_dma: irt_dma@1500b000 {
			compatible = "mediatek,mt8696-irt";
			reg = <0 0x1500b000 0 0x100>, /*irt_dma*/
			      <0 0x15000000 0 0x100>; /*disp_top*/
			power-domains =
				<&scpsys MT8696_POWER_DOMAIN_DISP_COMMON>;
			clocks = <&dispsys CLK_IMG_IRT_DMA>;
			clock-names = "irt_dma";
			interrupts = <GIC_SPI 289 IRQ_TYPE_LEVEL_HIGH>;
			iommus = <&iommu M4U_PORT_IRT_DMA_RW>;
			mediatek,larb = <&larb6>;
		};

		imgresz0: imgresz@1500c000 {
			compatible = "mediatek,mt8696-imgresz";
			reg = <0 0x1500c000 0 0x400>,
				  <0 0x1500ce00 0 0x100>;
			mediatek,imgreszid = <0>;
			power-domains =
				<&scpsys MT8696_POWER_DOMAIN_DISP_COMMON>;
			clocks = <&dispsys CLK_IMGRSZ>;
			clock-names = "imgrz_cg";
			mediatek,larb = <&larb5>;
			interrupts = <GIC_SPI 288 IRQ_TYPE_LEVEL_HIGH>;
			iommus = <&iommu M4U_PORT_IMG_UFO_REQ>,
					 <&iommu M4U_PORT_IMG_LEN_REQ>,
				     <&iommu M4U_PORT_IMG_WR_REQ>;
		};

		disp_fg: disp_fg@15001000 {
			compatible = "mediatek,mt8696-fg";
			reg = <0 0x15011000 0 0x1000>,
			      <0 0x15014000 0 0x1000>;
		};

		imgresz1: imgresz@1500c400 {
			compatible = "mediatek,mt8696-imgresz";
			reg = <0 0x1500c400 0 0x400>,
				  <0 0x1500cf00 0 0x100>;
			mediatek,imgreszid = <1>;
			power-domains =
				<&scpsys MT8696_POWER_DOMAIN_DISP_COMMON>;
			clocks = <&dispsys CLK_IMGRSZ>;
			clock-names = "imgrz_cg";
			interrupts = <GIC_SPI 287 IRQ_TYPE_LEVEL_HIGH>;
			iommus = <&iommu M4U_PORT_IMG_UFO_REQ_CH2>,
					 <&iommu M4U_PORT_IMG_LEN_REQ_CH2>,
				     <&iommu M4U_PORT_IMG_WR_REQ_CH2>;
			mediatek,larb = <&larb6>;
		};

		vcu: vcu@16000000 {
			compatible = "mediatek-vcu";
			mediatek,vcuid = <0>;
			mediatek,vcuname = "vcu";
			reg = <0 0x16000000 0 0x40000>,/* VDEC_BASE */
				<0 0x18010000 0 0x10000>;/* VENC_BASE */
			iommus = <&iommu M4U_PORT_HW_VDEC_MC_EXT>;
			mediatek,mailbox-gce = <&gce_mbox>;
			mediatek,enc_gce_th_num = <1>;

			mboxes =
				<&gce_mbox 6 0 CMDQ_THR_PRIO_1>;

			gce-event-names = "venc_eof",
				"venc_cmdq_pause_done",
				"venc_mb_done",
				"venc_sps_done",
				"venc_pps_done",
				"venc_128B_cnt_done";

			gce-events =
			<&gce_mbox CMDQ_EVENT_VENC_FRAME_DONE>,
			<&gce_mbox CMDQ_EVENT_VENC_PAUSE_DONE>,
			<&gce_mbox CMDQ_EVENT_VENC_MB_DONE>,
			<&gce_mbox CMDQ_EVENT_VENC_SPS_DONE>,
			<&gce_mbox CMDQ_EVENT_VENC_PPS_DONE>,
			<&gce_mbox CMDQ_EVENT_VENC_128BYTE_COUNT_DONE>;
		};

		vdec@16000000 {
			compatible = "mediatek,mt8696-vcodec-dec";
			reg = <0 0x16000000 0 0x1000>,/* VDEC_SYS */
				 <0 0x16020000 0 0x1000>,/* VDEC_VLD */
				 <0 0x16025000 0 0x4000>,/* VDEC_MISC */
				 <0 0x16010000 0 0x7000>,/* VDEC_LAT_MISC */
				 <0 0x16004000 0 0x1000>;/* VDEC_RACING_CTRL */
			mediatek,larb = <&larb1 &larb7>;
			iommus = <&iommu M4U_PORT_HW_VDEC_MC_EXT>,/*LARB1*/
				 <&iommu M4U_PORT_HW_VDEC_UFO_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_PP_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_PRED_RD_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_PRED_WR_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_PPWRAP_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_TILE_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_VLD_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_VLD2_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_AVC_MV_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_LAT_VLD_EXT>,/*LARB7*/
				 <&iommu M4U_PORT_HW_VDEC_LAT_VLD2_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_LAT_AVC_MV_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_LAT_PRED_RD_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_LAT_TILE_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_LAT_WDMA_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_UFO_ENC_EXT>;
			mediatek,vcu = <&vcu>;
			power-domains =
				<&scpsys MT8696_POWER_DOMAIN_VDEC_SOC>;
			clocks = <&vdec_gcon CLK_VDECEN>,
				<&vdec_gcon CLK_VDEC_L1EN>,
				<&vdec_soc_gcon CLK_VDSOC_VSEN>,
				<&vdec_soc_gcon CLK_VDSOC_L1_SOCEN>,
				<&vdec_soc_gcon CLK_VDSOC_LSEN>,
				<&topckgen CLK_TOP_VDEC_SLOW_SEL>;
			clock-names = "MT_VDECEN",
				"MT_VDEC_L1EN",
				"MT_VDSOC_VSEN",
				"MT_VDSOC_L1_SOCEN",
				"MT_VDSOC_LSEN",
				"MT_TOPCK_SLOW_SELEN";
			interrupts = <GIC_SPI 243 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 242 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 317 IRQ_TYPE_LEVEL_HIGH>;
		};

		vdec_core@16000000 {
			compatible = "mediatek,mt8696-vcodec-dec-core0";
			power-domains =
				<&scpsys MT8696_POWER_DOMAIN_VDEC_CORE0>;
		};

		larb7: larb@1600d000 {
			compatible = "mediatek,mt8696-smi-larb";
			reg = <0 0x1600d000 0 0x1000>;
			mediatek,smi = <&smi_common>;
			mediatek,larb-id = <7>;
			clocks = <&mmsys CLK_MMCG8_SMI_L7>,
				 <&vdec_soc_gcon CLK_VDSOC_L1_SOCEN>;
			clock-names = "apb", "smi";
			power-domains =
				<&scpsys MT8696_POWER_DOMAIN_VDEC_SOC>;
		};

		vdec_soc_gcon: vdec_soc_gcon@1600f000 {
			compatible = "mediatek,vdec_soc_gcon", "syscon";
			reg = <0 0x1600f000 0 0x10000>;
			#clock-cells = <1>;
		};

		vdec: vdec@16020000 {
			compatible = "mediatek,vdec";
			reg = <0 0x16020000 0 0xd000>;
			interrupts = <GIC_SPI 243 IRQ_TYPE_LEVEL_HIGH>;
		};

		larb1: larb@1602e000 {
			compatible = "mediatek,mt8696-smi-larb";
			reg = <0 0x1602e000 0 0x1000>;
			mediatek,smi = <&smi_common>;
			mediatek,larb-id = <1>;
			clocks = <&mmsys CLK_MMCG5_SMI_L1>,
				 <&vdec_gcon CLK_VDEC_L1EN>;
			clock-names = "apb", "smi";
			power-domains =
				<&scpsys MT8696_POWER_DOMAIN_VDEC_CORE0>;
		};

		vdec_gcon: vdec_gcon@1602f000 {
			compatible = "mediatek,vdec_gcon", "syscon";
			reg = <0 0x1602f000 0 0x10000>;
			#clock-cells = <1>;
		};

		venc: syscon@18000000 {
			compatible = "mediatek,mt8696-vencsys", "syscon";
			reg = <0 0x18000000 0 0x1000>;
			#clock-cells = <1>;
		};

		venc@18010000 {
			compatible = "mediatek,mt8696-vcodec-enc";
			reg = <0 0x18010000 0 0x2000>;
			mediatek,larb = <&larb3>;
			iommus = <&iommu M4U_PORT_VENC_RCPU>,/*LARB3*/
				 <&iommu M4U_PORT_VENC_REC_FRM>,
				 <&iommu M4U_PORT_VENC_BSDMA>,
				 <&iommu M4U_PORT_VENC_SV_COMV>,
				 <&iommu M4U_PORT_VENC_RD_COMV>,
				 <&iommu M4U_PORT_VENC_CUR_CHROMA>,
				 <&iommu M4U_PORT_VENC_REF_CHROMA>,
				 <&iommu M4U_PORT_VENC_CUR_LUMA>,
				 <&iommu M4U_PORT_VENC_REF_LUMA>;
			interrupts = <GIC_SPI 240 IRQ_TYPE_LEVEL_HIGH>;
			mediatek,vcu = <&vcu>;
			power-domains =	<&scpsys MT8696_POWER_DOMAIN_VENC>;
			clocks =
				<&venc CLK_VENC_SMI_CON>,
				<&venc CLK_VENC_CON>;
			clock-names =
				"MT_VENC_SMI",
				"MT_VENC_CON";
		};

		larb3: larb@18002000 {
			compatible = "mediatek,mt8696-smi-larb";
			reg = <0 0x18002000 0 0x1000>;
			mediatek,smi = <&smi_common>;
			mediatek,larb-id = <3>;
			clocks = <&mmsys CLK_MMCG11_SMI_L3>,
				 <&venc CLK_VENC_SMI_CON>;
			clock-names = "apb", "smi";
			power-domains =	<&scpsys MT8696_POWER_DOMAIN_VENC>;
		};

		hdmitx: hdmitx@1a000000 {
			compatible = "mediatek,mt8696-hdmitx21";
			reg = <0 0x14001800 0 0x100>, /* RGB2HDMI */
			      <0 0x10014000 0 0x100>, /* CEC */
			      <0 0x1a000000 0 0x1000>, /* HDMI Tx Digital */
			      <0 0x11f30000 0 0x100>, /* HDMI Tx Analog */
			      <0 0x14001000 0 0xd00>; /* vdout */
			power-domains = <&scpsys MT8696_POWER_DOMAIN_HDMITX>;
			clocks = <&infrasys CLK_INFRA_CEC>,
				 <&topckgen CLK_TOP_HD_SEL>,
				 <&topckgen CLK_TOP_SD_SEL>,
				 <&topckgen CLK_TOP_HDMITX_PIXEL>,
				 <&topckgen CLK_TOP_HDMITX_PIXEL_D6>,
				 <&topckgen CLK_TOP_HMT_PX_D3>,
				 <&topckgen CLK_TOP_HDCP_SEL>,
				 <&topckgen CLK_TOP_HDCP_24MSEL>,
				 <&topckgen CLK_TOP_HD20_DACR_SEL>,
				 <&topckgen CLK_TOP_HD20_HDCP_SEL>,
				 <&topckgen CLK_TOP_HDMI_APB_SEL>,
				 <&topckgen CLK_TOP_HDMI_SEL>,
				 <&mmsys CLK_MMCG23_RGB2HDMI>,
				 <&mmsys CLK_MMCG0_SD_PPF>,
				 <&mmsys CLK_MMCG1_P2I>,
				 <&topckgen CLK_TOP_OSDPLL_D3AB>;
			clock-names = "hdmi_cec",
				      "hd_sel",
				      "sd_sel",
				      "txpxlclk",
				      "txpxlckd6",
				      "hdmi_pxd3",
				      "hdmi_hdcp",
				      "hdmi_hdcp24",
				      "hd20_dacrsel",
				      "hd20_hdcpsel",
				      "hdmi_apbsel",
				      "hdmi_sel",
				      "hdmi_rgb2hdmien",
				      "hdmi_sdppf",
				      "hdmi_p2i",
				      "hdmi_osdpll";
			interrupts = <GIC_SPI 196 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 192 IRQ_TYPE_LEVEL_HIGH>;
			status = "okay";
		};

		earc_rx_codec: earc-receiver@1a001000 {
			compatible = "mediatek,earc-rx";
			reg = <0 0x1a001000 0 0x1000>, /* EARC RX Digital */
			      <0 0x11f30000 0 0x100>, /* EARC RX Analog */
			      <0 0x1a000000 0 0x1000>, /* HDMI Tx Digital */
			      <0 0x10005000 0 0x2000>; /* EARC Monitor */
			clocks = <&topckgen CLK_TOP_HDMI_APB_SEL>;
			clock-names = "hdmi_apb_sel";
			earcrx-gpios = <&pio 64 0>;
			interrupts = <GIC_SPI 197 IRQ_TYPE_LEVEL_HIGH>;
			status = "okay";
		};

		cmdq-test {
			compatible = "mediatek,cmdq-test";
			mediatek,gce = <&gce_mbox>;
			mboxes =
			<&gce_mbox 23 CMDQ_NO_TIMEOUT CMDQ_THR_PRIO_1>,
			<&gce_mbox 22 CMDQ_NO_TIMEOUT CMDQ_THR_PRIO_1>,
			<&gce_mbox_svp 12 CMDQ_NO_TIMEOUT CMDQ_THR_PRIO_1>;
			token_user0 = /bits/ 16 <CMDQ_SYNC_TOKEN_USER_0>;
			token_gpr_set4 = /bits/ 16 <CMDQ_SYNC_TOKEN_GPR_SET_4>;
		};

		display-pm-mm-top {
			compatible = "mediatek,mt8696-disp-clk";
			mediatek,pm_type = <0>;
			power-domains = <&scpsys MT8696_POWER_DOMAIN_MMSYS_TOP>;
			clocks = <&apmixedsys CLK_APMIXED_TVDPLL>,
				 <&topckgen CLK_TOP_TVDPLL_D2>,
				 <&apmixedsys CLK_APMIXED_OSDPLL>,
				 <&topckgen CLK_TOP_OSDPLL_D2>,
				 <&topckgen CLK_TOP_OSDPLL_D4>,
				 <&topckgen CLK_TOP_HD_SEL>,
				 <&topckgen CLK_TOP_SD_SEL>,
				 <&topckgen CLK_TOP_OSD_SEL>,
				 <&topckgen CLK_TOP_VDO3_SEL>,
				 <&topckgen CLK_TOP_VDO4_SEL>,
				 <&clk26m>,
				 <&mmsys CLK_MMCG10_VDOUT_MM>,
				 <&mmsys CLK_MMCG25_DGI>,
				 <&mmsys CLK_MMCG3_FAKEG>,
				 <&mmsys CLK_MMCG13_FMTTER>,
				 <&mmsys CLK_MMCG16_OF>,
				 <&mmsys CLK_MMCG15_OSD_FBDC>,
				 <&mmsys CLK_MMCG19_OF_SI2MI>,
				 <&mmsys CLK_MMCG17_OF_FIFO>,
				 <&mmsys CLK_MMCG18_OF_HDR>,
				 <&mmsys CLK_MMCG20_HDR_ADL>,
				 <&mmsys CLK_MMCG14_DISP_MIX>,
				 <&mmsys CLK_MMCG22_HDR_VDO>,
				 <&mmsys CLK_MMCG21_HDR_FIFO>,
				 <&topckgen CLK_TOP_HDMITX_PIXEL>,
				 <&topckgen CLK_TOP_HDMITX_PIXEL_D2>;
			clock-names = "tvdpll",
				      "tvdpll_d2",
				      "osdpll",
				      "osdpll_d2",
				      "osdpll_d4",
				      "hd_sel",
				      "sd_sel",
				      "osd_sel",
				      "vdo3_sel",
				      "vdo4_sel",
				      "clk26m",
				      "vdout_sys",
				      "dgi",
				      "fake_eng",
				      "fmt_tg",
				      "osd_fhd",
				      "osd_fbdc",
				      "osd_fhd_sim2miu",
				      "fhd_gfx_fe_fifo",
				      "fhd_hdr_gfx_fe",
				      "hdr_adl",
				      "disp_mix",
				      "hdr_vdo_be",
				      "hdr_be_fifo",
				      "hdmi_tx_pixel",
				      "hdmi_tx_pixel_d2";
		};

		display-pm-mm-com {
			compatible = "mediatek,mt8696-disp-clk";
			mediatek,pm_type = <1>;
			power-domains =
			<&scpsys MT8696_POWER_DOMAIN_MMSYS_COMMON>;
			clocks = <&mmsys CLK_MMCG3_HDMI_MD>,
				 <&mmsys CLK_MMCG5_W2D>,
				 <&mmsys CLK_MMCG1_P2I>,
				 <&mmsys CLK_MMCG0_SD_PPF>,
				 <&mmsys CLK_MMCG4_VIDEO_IN>,
				 <&mmsys CLK_MMCG2_VM_TOP>;
			clock-names = "hdmi_metadata",
				      "w2d",
				      "p2i",
				      "sdppf",
				      "vdoin",
				      "vm";
		};

		display-pm-osd-uhd {
			compatible = "mediatek,mt8696-disp-clk";
			mediatek,pm_type = <2>;
			power-domains = <&scpsys MT8696_POWER_DOMAIN_OSD_UHD>;
			clocks = <&mmsys CLK_MMCG7_OU>,
				 <&mmsys CLK_MMCG8_OU_FIFO>,
				 <&mmsys CLK_MMCG9_OU_HDR>;
			clock-names = "osd_uhd",
				      "uhd_gfx_fe_fifo",
				      "uhd_hdr_gfx_fe";
		};

		display-pm-disp-m {
			compatible = "mediatek,mt8696-disp-clk";
			mediatek,pm_type = <3>;
			power-domains = <&scpsys MT8696_POWER_DOMAIN_DISP_MAIN>;
			clocks = <&dispsys CLK_IMG_VDO3>,
				 <&dispsys CLK_IMG_DISPFMT3>,
				 <&dispsys CLK_IMG_MVDO_FIFO>,
				 <&dispsys CLK_IMG_MFILM_GRAIN>,
				 <&dispsys CLK_IMG_MHDR_VDO_FE>,
				 <&dispsys CLK_IMG_MVDO_FE_ADL>,
				 <&dispsys CLK_IMG_R2R>;
			clock-names = "vdo3",
				      "dispfmt3",
				      "m_vdo_fe_fifo",
				      "m_film_grain",
				      "m_hdr_vdo_fe",
				      "m_vdo_fe_adl",
				      "r2r";
		};

		display-pm-disp-s {
			compatible = "mediatek,mt8696-disp-clk";
			mediatek,pm_type = <4>;
			power-domains = <&scpsys MT8696_POWER_DOMAIN_DISP_SUB>;
			clocks = <&dispsys CLK_IMG_VDO4>,
				 <&dispsys CLK_IMG_DISPFMT4>,
				 <&dispsys CLK_IMG_SVDO_FIFO>,
				 <&dispsys CLK_IMG_SFILMGRAIN>,
				 <&dispsys CLK_IMG_SHDR_VDO_FE>;
			clock-names = "vdo4",
				      "dispfmt4",
				      "s_vdo_fe_fifo",
				      "s_film_grain",
				      "s_hdr_vdo_fe";
		};

		gpio_keys: gpio_keys {
			compatible = "gpio-keys";
		};

		ion: ion {
			compatible = "mediatek,ion";
			iommus = <&iommu M4U_PORT_IMG_WR_REQ>;
		};

		mfg_async: mfg_async {
			compatible = "mediatek,mt8696-mfg-async";
			power-domains = <&scpsys MT8696_POWER_DOMAIN_MFG>;
		};

		mfg_2d: mfg_2d {
			compatible = "mediatek,mt8696-mfg-2d";
			power-domains = <&scpsys MT8696_POWER_DOMAIN_MFG2>;
		};

		mfg_3d: mfg_3d {
			compatible = "mediatek,mt8696-mfg-3d";
			power-domains = <&scpsys MT8696_POWER_DOMAIN_MFG3>;
		};

		mtkfb: mtkfb {
			compatible = "mediatek,mtkfb";
			iommus = <&iommu M4U_PORT_UHD_OSD_HEADER>,
				 <&iommu M4U_PORT_UHD_OSD>,
				 <&iommu M4U_PORT_UHD_HDR_GFX_FE_ADL>,
				 <&iommu M4U_PORT_DISP_FAKE0>,
				 <&iommu M4U_PORT_FHD_OSD_HEADER>,
				 <&iommu M4U_PORT_FHD_OSD>,
				 <&iommu M4U_PORT_VIDEO_IN_CH0>,
				 <&iommu M4U_PORT_VIDEO_IN_CH1>,
				 <&iommu M4U_PORT_VIDEO_IN_CH2>,
				 <&iommu M4U_PORT_W2D_CH0>,
				 <&iommu M4U_PORT_W2D_CH1>,
				 <&iommu M4U_PORT_W2D_CH2>,
				 <&iommu M4U_PORT_HDR_VDO_BE_ADL>,
				 <&iommu M4U_PORT_HDR_VDO_BE_ML>,
				 <&iommu M4U_PORT_DISP_FAKE4>,
				 <&iommu M4U_PORT_VDO3_UFOD_Y_LENGTH>,
				 <&iommu M4U_PORT_VDO3_UFOD_C_LENGTH>,
				 <&iommu M4U_PORT_VDO3_UFOD_Y0>,
				 <&iommu M4U_PORT_VDO3_UFOD_Y2>,
				 <&iommu M4U_PORT_VDO3_UFOD_C1>,
				 <&iommu M4U_PORT_VDO3_UFOD_C3>,
				 <&iommu M4U_PORT_VDO4_UFOD_C0>,
				 <&iommu M4U_PORT_VDO4_UFOD_Y1>,
				 <&iommu M4U_PORT_R2R_Y>,
				 <&iommu M4U_PORT_IMG_UFO_REQ>,
				 <&iommu M4U_PORT_IMG_LEN_REQ>,
				 <&iommu M4U_PORT_IMG_WR_REQ>,
				 <&iommu M4U_PORT_M_VDO_ADL>,
				 <&iommu M4U_PORT_M_VDO_ML>,
				 <&iommu M4U_PORT_DISP_FAKE5>,
				 <&iommu M4U_PORT_VDO4_UFOD_Y_LENGTH>,
				 <&iommu M4U_PORT_VDO4_UFOD_C_LENGTH>,
				 <&iommu M4U_PORT_VDO4_UFOD_Y0>,
				 <&iommu M4U_PORT_VDO4_UFOD_C1>,
				 <&iommu M4U_PORT_VDO3_UFOD_Y1>,
				 <&iommu M4U_PORT_VDO3_UFOD_Y3>,
				 <&iommu M4U_PORT_VDO3_UFOD_C0>,
				 <&iommu M4U_PORT_VDO3_UFOD_C2>,
				 <&iommu M4U_PORT_R2R_C>,
				 <&iommu M4U_PORT_R2R_CC>,
				 <&iommu M4U_PORT_IMG_UFO_REQ_CH2>,
				 <&iommu M4U_PORT_IMG_LEN_REQ_CH2>,
				 <&iommu M4U_PORT_IMG_WR_REQ_CH2>,
				 <&iommu M4U_PORT_IRT_DMA_RW>,
				 <&iommu M4U_PORT_S_VDO_ADL>,
				 <&iommu M4U_PORT_S_VDO_ML>,
				 <&iommu M4U_PORT_DISP_FAKE6>;
			mediatek,larb = <&larb0>,
					<&larb4>,
					<&larb5>,
					<&larb6>;
			mboxes = <&gce_mbox 4 0xffffffff 1>,
				 <&gce_mbox 5 0xffffffff 4>,
				 <&gce_mbox 0 0xffffffff 4>,
				 <&gce_mbox_svp 8 0xffffffff 4>;
		 };

		pseudo-m4u {
			compatible = "mediatek,mtk-pseudo-m4u";
			iommus = <&iommu M4U_PORT_IMG_WR_REQ>;
		};

	};

	mtee {
		compatible = "mediatek,mtee";
	};

	optee {
		compatible = "linaro,optee-tz";
		method = "smc";
		clocks = <&topckgen CLK_TOP_GCPU_SEL>,
			 <&topckgen CLK_TOP_ECC_SEL>;
		clock-names = "GCPU_B", "ECC";
	};

	clkao: clkao {
		compatible = "simple-bus";
	};

	dvfsp: dvfsp@0010bc00 {
		compatible = "mediatek,mt8696-dvfsp";
		reg = <0 0x0010bc00 0 0x1400>;
		state = <1>;
		change_flag = <0>;
		little-rise-time = <1000>;
		little-down-time = <750>;
		L-table = <2000 96 1 1
			   1933 92 1 1
			   1866	88 1 1
			   1800 83 1 1
			   1733 80 1 1
			   1666 75 1 1
			   1548 71 1 1
			   1475 66 2 1
			   1375 64 2 1
			   1275 58 2 1
			   1175 54 2 1
			   1075 49 2 1
			    999 46 2 1
			    925 43 2 1
			    850 40 2 1
			    774 38 2 1 >;

		CCI-table = <1400 96 2 1
			     1353 92 2 1
			     1306 88 2 1
			     1260 84 2 1
			     1190 78 2 1
			     1155 75 2 1
			     1120 71 2 1
			      984 64 2 1
			      917 62 2 1
			      827 58 2 1
			      737 54 2 2
			      669 51 2 2
			      579 47 2 2
			      512 44 2 2
			      445 41 2 2
			      400 38 2 2 >;

	};

	lastpc: lastpc {
		compatible = "mediatek,lastpc";
	};

	mt_cpufreq: mt_cpufreq {
		compatible = "mediatek,mt-cpufreq";
	};

	dvfsrc: dvfsrc {
		compatible = "mediatek,dvfsrc-mt8696";
		type = <0>;
		status = "disabled";
	};

	ice: ice_debug {
		compatible = "mediatek,mt8696-ice_debug",
			     "mediatek,mt2701-ice_debug";
		clocks = <&infrasys CLK_INFRA_DBGCLK>;
		clock-names = "ice_dbg";
	};

};

#include "mt8696-clkao.dtsi"
