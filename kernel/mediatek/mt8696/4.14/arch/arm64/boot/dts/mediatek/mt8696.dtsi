				 <&topckgen CLK_TOP_APLL_SEL>,
				 <&topckgen CLK_TOP_APLL2_SEL>,
				 <&topckgen CLK_TOP_APLL3_SEL>,
				 <&topckgen CLK_TOP_APLL4_SEL>,
				 <&topckgen CLK_TOP_APLL5_SEL>,
				 <&topckgen CLK_TOP_APLL1_D8>,
				 <&topckgen CLK_TOP_APLL2_D8>,
				 <&topckgen CLK_TOP_APLL3_D8>,
				 <&topckgen CLK_TOP_APLL4_D8>,
				 <&topckgen CLK_TOP_APLL5_D8>,
				 <&topckgen CLK_TOP_ASML_SEL>,
				 <&topckgen CLK_TOP_ASMM_SEL>,
				 <&topckgen CLK_TOP_ASMH_SEL>,
				 <&topckgen CLK_TOP_APLL12_DIV4>,
				 <&topckgen CLK_TOP_APLL12_DIV0>,
				 <&topckgen CLK_TOP_APLL12_DIV1>,
				 <&topckgen CLK_TOP_APLL12_DIV2>,
				 <&topckgen CLK_TOP_APLL12_DIV3>,
				 <&topckgen CLK_TOP_AUD_IEC>,
				 <&topckgen CLK_TOP_I2SI1_M>,
				 <&topckgen CLK_TOP_I2SI2_M>,
				 <&topckgen CLK_TOP_I2SO1_M>,
				 <&topckgen CLK_TOP_I2SO2_M>,
				 <&topckgen CLK_TOP_I2SI1_SEL>,
				 <&topckgen CLK_TOP_I2SI2_SEL>,
				 <&topckgen CLK_TOP_I2SO1_SEL>,
				 <&topckgen CLK_TOP_I2SO2_SEL>,
				 <&apmixedsys CLK_APMIXED_APLL1>,
				 <&apmixedsys CLK_APMIXED_APLL2>,
				 <&apmixedsys CLK_APMIXED_APLL3>,
				 <&apmixedsys CLK_APMIXED_APLL4>,
				 <&apmixedsys CLK_APMIXED_APLL5>;
			clock-names = "audio_26msel",
				      "audio_sel",
				      "aud_intbussel",
				      "infra_ipsys",
				      "a1syshp_sel",
				      "intdir_sel",
				      "a2syshp_sel",
				      "a3syshp_sel",
				      "a4syshp_sel",
				      "apll3_d4",
				      "apll4_d4",
				      "apll5_d4",
				      "hdmirx_apll_d6",
				      "apll_sel",
				      "apll2_sel",
				      "apll3_sel",
				      "apll4_sel",
				      "apll5_sel",
				      "apll1_d8",
				      "apll2_d8",
				      "apll3_d8",
				      "apll4_d8",
				      "apll5_d8",
				      "asml_sel",
				      "asmm_sel",
				      "asmh_sel",
				      "apll12_div4",
				      "apll12_div0",
				      "apll12_div1",
				      "apll12_div2",
				      "apll12_div3",
				      "hf_faud_iec_ck",
				      "hf_fi2si1_m_ck",
				      "hf_fi2si2_m_ck",
				      "hf_fi2so1_m_ck",
				      "hf_fi2so2_m_ck",
				      "i2si1_sel",
				      "i2si2_sel",
				      "i2so1_sel",
				      "i2so2_sel",
				      "apll1",
				      "apll2",
				      "apll3",
				      "apll4",
				      "apll5";
			assigned-clocks =
					<&topckgen CLK_TOP_APLL_SEL>,
					<&topckgen CLK_TOP_APLL2_SEL>,
					<&topckgen CLK_TOP_APLL3_SEL>,
					<&topckgen CLK_TOP_APLL4_SEL>,
					<&topckgen CLK_TOP_APLL5_SEL>,
					<&topckgen CLK_TOP_ASML_SEL>,
					<&topckgen CLK_TOP_ASMM_SEL>,
					<&topckgen CLK_TOP_ASMH_SEL>;
			assigned-clock-parents =
					<&topckgen CLK_TOP_APLL1_D8>,
					<&topckgen CLK_TOP_APLL2_D8>,
					<&topckgen CLK_TOP_APLL3_D8>,
					<&topckgen CLK_TOP_APLL4_D8>,
					<&topckgen CLK_TOP_APLL5_D8>,
					<&topckgen CLK_TOP_UNIVPLL2_D4>,
					<&topckgen CLK_TOP_UNIVPLL2_D4>,
					<&topckgen CLK_TOP_UNIVPLL2_D4>;
			mediatek,topckgen-regmap = <&topckgen>;
			mediatek,scpsys-regmap = <&scpsys>;
			power-domains = <&scpsys MT8696_POWER_DOMAIN_AUDIO>;
			status = "disable";
		};

		afe: audio-controller@11228000 {
			compatible = "mediatek,mt8696-afe-pcm";
			reg = <0 0x11228000 0 0x4000>;
			interrupts = <GIC_SPI 267 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&apmixedsys CLK_APMIXED_APLL1>,
				 <&apmixedsys CLK_APMIXED_APLL2>,
				 <&infrasys CLK_INFRA_AUDIO>,
				 <&topckgen CLK_TOP_APLL1_D2>,
				 <&topckgen CLK_TOP_APLL1_D4>,
				 <&topckgen CLK_TOP_APLL1_D8>,
				 <&topckgen CLK_TOP_APLL1_D16>,
				 <&topckgen CLK_TOP_APLL2_D2>,
				 <&topckgen CLK_TOP_APLL2_D4>,
				 <&topckgen CLK_TOP_APLL2_D8>,
				 <&topckgen CLK_TOP_APLL2_D16>,
				 <&topckgen CLK_TOP_AUDIO_SEL>,
				 <&topckgen CLK_TOP_AUDIO_26MSEL>,
				 <&topckgen CLK_TOP_AUD_INTBUSSEL>,
				 <&topckgen CLK_TOP_APLL_SEL>,
				 <&topckgen CLK_TOP_APLL2_SEL>,
				 <&topckgen CLK_TOP_A1SYSHP_SEL>,
				 <&topckgen CLK_TOP_A2SYSHP_SEL>,
				 <&topckgen CLK_TOP_APLL12_DIV0>,
				 <&topckgen CLK_TOP_APLL12_DIV2>,
				 <&topckgen CLK_TOP_APLL12_DIV3>,
				 <&topckgen CLK_TOP_I2SO1_SEL>,
				 <&topckgen CLK_TOP_I2SO2_SEL>,
				 <&topckgen CLK_TOP_I2SI1_SEL>;
			clock-names = "apll1",
				      "apll2",
				      "infra_audio",
				      "apll1_d2",
				      "apll1_d4",
				      "apll1_d8",
				      "apll1_d16",
