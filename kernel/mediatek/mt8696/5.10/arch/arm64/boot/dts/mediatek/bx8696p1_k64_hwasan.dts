/dts-v1/;

/plugin/;
#include <dt-bindings/interrupt-controller/irq.h>
#include "mediatek/mt8696-pinfunc.h"
#include <dt-bindings/gpio/gpio.h>

#define ROOT_NODE &odm

ROOT_NODE {
	model = "MediaTek MT8696 P1V1 board";
	extcon_usb: extcon_iddig {
		compatible = "linux,extcon-usb-gpio";
		status = "disabled";
	};

	g2293_vgpu: gpio-regulator {
		compatible = "regulator-gpio";
		regulator-name = "g2293_vgpu";
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <900000>;
		enable-gpio = <&pio 2 GPIO_ACTIVE_HIGH>;
		gpios = <&pio 28 GPIO_ACTIVE_HIGH>;
		states = <800000 0x0
			900000 0x1>;
		startup-delay-us = <5000>;
		enable-active-high;
	};

	/* WOW IRQ : GPIO0 => EINT11 */
	mediatek,mt7921-wifi {
		compatible = "mediatek,mediatek_wifi_ctrl";
		interrupt-parent = <&pio>;
		interrupts = <11 IRQ_TYPE_LEVEL_LOW 0 0x0>;
		status = "okay";
	};

	/* WOBLE IRQ  GPIO1 => EINT12*/
	mediatek,mt7921-bt {
		compatible = "mediatek,woble_eint";
		interrupt-parent = <&pio>;
		interrupts = <12 IRQ_TYPE_LEVEL_LOW 1 0x0>;
		status = "okay";
	};

	tboard_thermistor0: thermal-sensor {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0>;
		io-channels = <&auxadc 0>;
		io-channel-names = "sensor-channel";
		temperature-lookup-table = <
						(-40000)	1712
						(-35000)	1686
						(-30000)	1654
						(-25000)	1615
						(-20000)	1570
						(-15000)	1517
						(-10000)	1457
						(-5000)	1390
						0	1316
						5000	1238
						10000	1155
						15000	1070
						20000	985
						25000	900
						30000	817
						35000	737
						40000	663
						45000	593
						50000	529
						55000	471
						60000	418
						65000	370
						70000	328
						75000	290
						80000	258
						85000	228
						90000	203
						95000	180
						100000	160
						105000	143
						110000	127
						115000	114
						120000	102
						125000	91
		>;
	};

	mmc_fixed_3v3: fixedregulator@0 {
		compatible = "regulator-fixed";
		regulator-name = "mmc_power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
	};

	mmc_fixed_1v8_io: fixedregulator@1 {
		compatible = "regulator-fixed";
		regulator-name = "mmc_io";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		enable-active-high;
	};

	mmc2_fixed_pwr: fixedregulator@2 {
		compatible = "regulator-fixed";
		regulator-name = "sdio_power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		regulator-always-on;
	};

	mmc2_fixed_pmu: fixedregulator@3 {
		compatible = "regulator-fixed";
		regulator-name = "sdio_pmu";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		startup-delay-us = <200000>;
		gpio = <&pio 26 0>;
		enable-active-high;
	};

	usb_vbus_5v0: fixedregulator@4 {
		compatible = "regulator-fixed";
		regulator-name = "vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-type = "voltage";
		regulator-always-on;
	};

	usb_vbus_3v3: fixedregulator@5 {
		compatible = "regulator-fixed";
		regulator-name = "usb vbus";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&afe {
	mediatek,etdm-clock-modes = <0 1>;
	mediatek,etdm-out-data-modes = <1 1>;
	mediatek,etdm-in-data-modes = <1 1>;
	mediatek,hdmi-clk-force-on = <1>;
	status = "okay";
};

&afe32 {
	mediatek,etdm-in-data-modes = <1 1 0>;
	mediatek,etdm-out-data-modes = <1 1 1>;
	mediatek,spdif-in-arc-mux = <2>;
	status = "okay";
};

&ap_ntc1 {
	thermal-sensors = <&tboard_thermistor0>;
};

&auxadc {
	status = "okay";
};

&dramc {
	dram_type = <5>;
	support_ch_cnt = <2>;
	ch_cnt = <2>;
	rk_cnt = <1>; /* dummy */
	mr_cnt = <4>;
	freq_cnt = <10>;
	rk_size = <0x40000000>;  /* dummy */
	mr = <0 0 0 0 0 0 0 0>;  /* dummy */
	freq_step = <3733 3200 0 0 0 0 0 0 0 0>;
};

&ethernet {
	pinctrl-names = "default";
	pinctrl-0 = <&eth_pins>;
	phy-handle = <&eth_phy>;
	eth-gpios = <&pio 149 0>;
	mac-address = [00 00 00 00 00 00];
	phy-mode = "rgmii";
	status = "disabled";
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		eth_phy: ethernet-phy@1 {
			compatible = "ethernet-phy-id001c.c916";
			reg = <1>;
		};
	};
};

&hdmitx {
	pinctrl-names = "default";
	pinctrl-0 = <&hdmi_default>;
};

&i2c3 {
	status = "okay";
	clock-frequency = <400000>;

	mt6395: mt6395@62 {
		compatible = "mediatek,mt6395-regulator";
		mt6395,irq-gpios = <&pio 4 0x0>;
		reg = <0x62>;
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_pins_eint>;
	};
};

&irrx {
	pinctrl-names = "default";
	pinctrl-0 = <&irrx_pins_ir_input>;
	status = "okay";
};

&mmc0 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	supports-cqe;
	hs400-ds-delay = <0x13014>;
	vmmc-supply = <&mmc_fixed_3v3>;
	vqmmc-supply = <&mmc_fixed_1v8_io>;
	non-removable;
	no-sd;
	no-sdio;
};

&mmc2 {
	status = "okay";
	pinctrl-names = "default", "state_uhs", "state_eint",
					"state_dat1", "state_low";
	pinctrl-0 = <&mmc2_pins_default>;
	pinctrl-1 = <&mmc2_pins_uhs>;
	pinctrl-2 = <&mmc2_pins_eint>;
	pinctrl-3 = <&mmc2_pins_dat1>;
	pinctrl-4 = <&mmc2_pins_low>;
	eint-gpios = <&pio 44 0>;
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	/*sd-uhs-ddr208;*/
	sd-uhs-sdr104;
	sd-uhs-sdr50;
	sd-uhs-sdr25;
	keep-power-in-suspend;
	enable-sdio-wakeup;
	cap-sdio-irq;
	cap-sdio-async-int;
	no-mmc;
	no-sd;
	non-removable;
	vmmc-supply = <&mmc2_fixed_pwr>;
	vqmmc-supply = <&mmc2_fixed_pmu>;
};

&pio {
	eth_pins: eth_default_pins {
		tx_pins {
			pinmux = <PINMUX_GPIO133__FUNC_GBE_TXD3>,
				 <PINMUX_GPIO134__FUNC_GBE_TXD2>,
				 <PINMUX_GPIO135__FUNC_GBE_TXD1>,
				 <PINMUX_GPIO136__FUNC_GBE_TXD0>,
				 <PINMUX_GPIO137__FUNC_GBE_TXC>,
				 <PINMUX_GPIO138__FUNC_GBE_TXEN>;
			drive-strength = <MTK_DRIVE_8mA>;
			bias-disable;
		};
		rx_pins {
			pinmux = <PINMUX_GPIO139__FUNC_GBE_RXD3>,
				 <PINMUX_GPIO140__FUNC_GBE_RXD2>,
				 <PINMUX_GPIO141__FUNC_GBE_RXD1>,
				 <PINMUX_GPIO142__FUNC_GBE_RXD0>,
				 <PINMUX_GPIO143__FUNC_GBE_RXDV>,
				 <PINMUX_GPIO145__FUNC_GBE_RXC>;
			drive-strength = <MTK_DRIVE_8mA>;
			bias-disable;
		};
		mdio_pins {
			pinmux = <PINMUX_GPIO146__FUNC_GBE_MDC>,
				 <PINMUX_GPIO147__FUNC_GBE_MDIO>;
			drive-strength = <MTK_DRIVE_8mA>;
			bias-disable;
		};
		phy_rstb {
			pinmux = <PINMUX_GPIO148__FUNC_GPIO148>;
			output-high;
		};
		gbe_vio33_en {
			pinmux = <PINMUX_GPIO150__FUNC_GPIO150>;
			output-high;
		};
	};

	hdmi_default: hdmi {
		hdmi_cec {
			pinmux = <PINMUX_GPIO110__FUNC_HDMITX20_CEC>;
			bias-disable;
		};
		hdmi_pins {
			pinmux = <PINMUX_GPIO112__FUNC_HDMITX20_SCL>,
				<PINMUX_GPIO113__FUNC_HDMITX20_SDA>;
			bias-disable;
		};
		hdmi_hotplug {
			pinmux = <PINMUX_GPIO111__FUNC_HDMITX20_HTPLG>;
			bias-pull-down;
		};
		hdmi_5vctl {
			pinmux = <PINMUX_GPIO2__FUNC_GPIO2>;
		};
	};

	irrx_pins_ir_input: irrx_pin_ir {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO63__FUNC_IR_IN>;
			bias-disable;
		};
	};

	mmc0_pins_default: mmc0default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO56__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO55__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO54__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO53__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO52__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO51__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO50__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO49__FUNC_MSDC0_DAT7>,
				 <PINMUX_GPIO57__FUNC_MSDC0_CMD>;
			input-enable;
			bias-pull-up;
		};

		pins_clk {
			pinmux = <PINMUX_GPIO48__FUNC_MSDC0_CLK>;
			bias-pull-down;
		};

		pins_rst {
			pinmux = <PINMUX_GPIO58__FUNC_MSDC0_RSTB>;
			bias-pull-up;
		};
	};

	mmc0_pins_uhs: mmc0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO56__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO55__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO54__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO53__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO52__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO51__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO50__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO49__FUNC_MSDC0_DAT7>,
				 <PINMUX_GPIO57__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins_clk {
			pinmux = <PINMUX_GPIO48__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins_ds {
			pinmux = <PINMUX_GPIO47__FUNC_MSDC0_DSL>;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins_rst {
			pinmux = <PINMUX_GPIO58__FUNC_MSDC0_RSTB>;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-up;
		};
	};

	mmc2_pins_default: mmc2default {
		pins_clk {
			pinmux = <PINMUX_GPIO40__FUNC_MSDC2_CLK>;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO45__FUNC_MSDC2_DAT0>,
				 <PINMUX_GPIO44__FUNC_MSDC2_DAT1>,
				 <PINMUX_GPIO43__FUNC_MSDC2_DAT2>,
				 <PINMUX_GPIO42__FUNC_MSDC2_DAT3>,
				 <PINMUX_GPIO46__FUNC_MSDC2_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	mmc2_pins_uhs: mmc2 {
		pins_clk {
			pinmux = <PINMUX_GPIO40__FUNC_MSDC2_CLK>;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO45__FUNC_MSDC2_DAT0>,
				 <PINMUX_GPIO44__FUNC_MSDC2_DAT1>,
				 <PINMUX_GPIO43__FUNC_MSDC2_DAT2>,
				 <PINMUX_GPIO42__FUNC_MSDC2_DAT3>,
				 <PINMUX_GPIO46__FUNC_MSDC2_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins_ds {
			pinmux = <PINMUX_GPIO41__FUNC_MSDC2_DSL>;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};
	};

	mmc2_pins_eint: dat1_eint {
		pins_dat1 {
			pinmux = <PINMUX_GPIO44__FUNC_GPIO44>;
			input-enable;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	mmc2_pins_dat1: sdio_dat1 {
		pins_dat1 {
			pinmux = <PINMUX_GPIO44__FUNC_MSDC2_DAT1>;
			input-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	mmc2_pins_low: sdio_low {
		pins_low {
			pinmux = <PINMUX_GPIO45__FUNC_GPIO45>,
				 <PINMUX_GPIO43__FUNC_GPIO43>,
				 <PINMUX_GPIO42__FUNC_GPIO42>,
				 <PINMUX_GPIO46__FUNC_GPIO46>,
				 <PINMUX_GPIO41__FUNC_GPIO41>;
			input-disable;
			bias-disable;
		};
	};

	pmic_pins_eint: pmic_pins_eint{
		pmic_pins {
			pinmux = <PINMUX_GPIO4__FUNC_GPIO4>;
			bias-disable;
		};
	};
};

&ssusb {
	vusb33-supply = <&usb_vbus_3v3>;
	vbus-supply = <&usb_vbus_5v0>;
	/* valid string: "", "host", "peripheral", "otg" */
	dr_mode = "otg";

	/*usb3-lpm-capable;*/
	/* wakeup-source; */
	maximum-speed = "high-speed";
	enable-manual-drd;

	default_mode = "peripheral";

	status = "okay";
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&scpsys {
	mfg-supply = <&g2293_vgpu>;
};

&mfg {
	reg-vgpu-supply = <&g2293_vgpu>;
};

&atf_aee_log_reserved_mem {
	compatible = "mediatek,mt8696-atf-aee-log";
	reg = <0 0x57240000 0 0x1000>;
};

&mboot_params_reserved_memory {
	compatible = "mediatek,mboot_params";
	reg = <0 0x59400000 0 0x1000>;
};

&ramoops {
	compatible = "ramoops";
	reg = <0 0x59410000 0 0x40000>;
	console-size = <0x40000>;
	pmsg-size = <0x0>;
};

&minirdump_reserved_memory {
	compatible = "mediatek,minirdump";
	reg = <0 0x594f0000 0 0x10000>;
};

&mrdump_cb_reserved_memory {
	compatible = "mediatek,mrdump_cb";
	reg = <0 0x59500000 0 0x1000>;
};

#include "mediatek/mt6395.dtsi"
